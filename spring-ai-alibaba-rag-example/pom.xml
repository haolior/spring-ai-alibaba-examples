<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alibaba.cloud.ai</groupId>
        <artifactId>spring-ai-alibaba-examples</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <version>${revision}</version>
    <artifactId>spring-ai-alibaba-rag-example</artifactId>
    <packaging>pom</packaging>

    <description>Spring AI Alibaba RAG Example</description>
    <name>Spring AI Alibaba RAG Examples</name>

	<modules>

<!--        向量数据库基础： 脱离大模型，演示如何单独对各种向量数据库进行连接、数据的 CRUD 以及最基础的相似度检索（Similarity Search）。-->
    <module>spring-ai-alibaba-vector-databases-example</module>


<!--        RAG 基础组件： 演示 RAG 的核心四大件（DocumentReader、Splitter、Embedding、VectorStore）如何原生组装。-->
        <module>rag-component-example</module>
<!--        模块化 RAG： 可能是对 RAG 核心逻辑的封装抽象，或者是一个标准的、可复用的 RAG 业务模块。-->
        <module>module-rag</module>



<!--        Pgvector 向量检索： 使用 PostgreSQL 的扩展 pgvector 实现 RAG。-->
<!--		<module>rag-pgvector-example</module>-->
<!--        ES 向量检索： 使用 Elasticsearch 作为向量数据库实现 RAG。-->
<!--        <module>rag-elasticsearch-example</module>-->
<!--        Milvus 向量检索： 使用专为海量向量设计的 Milvus 数据库实现 RAG。-->
<!--        <module>rag-milvus-example</module>-->



<!--        多模型混合实战： 结合 OpenAI、阿里 DashScope（通义千问）和 Pgvector 的多模型混合 RAG 示例。-->
<!--        <module>rag-openai-dashscope-pgvector-example</module>-->
<!--        ES 自动装配： 演示 Spring Boot 最核心的 starter 自动装配机制，如何通过配置文件零代码连接 ES。-->
<!--        <module>rag-elasticsearch-autoconfigure-example</module>-->


<!--        ETL 数据流水线： 演示非结构化数据（PDF/Docx）如何通过 提取(Extract)-转换(Transform)-加载(Load) 变成向量存入数据库。-->
<!--        <module>rag-etl-pipeline-example</module>-->
<!--        并行并发优化： 演示在检索（Retrieval）或生成（Generation）阶段，如何利用并发提高 RAG 的响应速度。-->
<!--        <module>rag-parallel-example</module>-->


<!--        百炼 RAG 知识库： 演示如何对接阿里云“百炼”平台。体验云端全托管的一体化知识库方案（免去自己搭建 ETL 和向量库的繁琐步骤）。-->
<!--        <module>bailian-rag-knowledge</module>-->


<!--        百炼 Agent 实战： 体验百炼平台提供的智能体能力，让大模型学会利用工具（Tools/Function Calling）自动在合适的时机去检索知识库。-->
<!--		<module>bailian-agent</module>-->
<!--        LangGraph 可控状态机 RAG： 终极通关大戏。脱离第三方云平台，在 Java 中纯代码用开源 LangGraph 构建具备反思、纠错、自适应思考能力的闭环高级 RAG。-->
<!--        <module>langgraph-custom-rag-example</module>-->

    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven-deploy-plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
